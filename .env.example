# Local development only. Copy to .env. Never commit .env.
# Do not put these values in NEXT_PUBLIC_ variables. The browser must not receive secrets.

KAI_ENV=development
KAI_API_HOST=0.0.0.0
KAI_API_PORT=8000
KAI_WEB_ORIGIN=http://localhost:3000
KAI_LOG_LEVEL=INFO

# Public browser origin for the API. This is not a secret.
NEXT_PUBLIC_KAI_API_URL=http://localhost:8000

# Leave infrastructure blank until you want the API to report them as configured.
# Phase 1 does not open these connections.
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=kai-documents
MINIO_SECURE=false

# Reserved. The API registers a local mock and does not select a vendor from this name.
KAI_MODEL_PROVIDER=unconfigured

# Local chat credential. Ignored when KAI_ENV=production. Leave blank to refuse chat.
# The Next.js server reads KAI_LOCAL_BEARER_TOKEN and KAI_API_ORIGIN. The browser does not.
KAI_API_ORIGIN=http://127.0.0.1:8000
KAI_LOCAL_BEARER_TOKEN=
KAI_LOCAL_USER_ID=
KAI_LOCAL_ORGANIZATION_ID=

# Used by docker compose. Replace the change-me values before starting containers.
POSTGRES_USER=kai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kai
MINIO_ROOT_USER=kai_minio
MINIO_ROOT_PASSWORD=change-me
